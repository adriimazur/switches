{
  "name": "docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:switches": "pnpm --filter switches-react build",
    "dev": "pnpm build:switches && next dev",
    "build": "pnpm build:switches && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "e2e": "pnpm build:switches && playwright test && DOCS_BASE_PATH=/switches playwright test",
    "e2e:root": "pnpm build:switches && playwright test",
    "e2e:base": "pnpm build:switches && DOCS_BASE_PATH=/switches playwright test"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "switches-react": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
